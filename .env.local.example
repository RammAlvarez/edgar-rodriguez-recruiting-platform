# Local overrides for development. Copy to `.env` (gitignored): `cp .env.local.example .env`.
# Nothing here is required: scripts/lib/env.mjs fills every variable with a local default.
# .env.example is the PRODUCTION list; do not copy that one to .env.

# Host ports of the compose services, when the defaults are taken by another project.
# PLATFORM_DB_PORT=5433
# PLATFORM_S3_PORT=9000
# PLATFORM_S3_CONSOLE_PORT=9001

# Local scripts (api, db:migrate, test:api) refuse a database that is not on this machine.
# Set to 1 only if you really mean to point them at a remote one.
# PLATFORM_ALLOW_REMOTE_DB=0
