/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strict": true,
    "paths": {
      "@platform/shared": [
        "./libs/shared/src/index.ts"
      ],
      "@platform/api-client": [
        "./libs/api-client/src/index.ts"
      ],
      "@platform/ui": [
        "./libs/ui/src/index.ts"
      ],
      "@platform/ui/*": [
        "./libs/ui/src/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/admin/tsconfig.app.json"
    },
    {
      "path": "./apps/admin/tsconfig.spec.json"
    },
    {
      "path": "./apps/candidates/tsconfig.app.json"
    },
    {
      "path": "./apps/candidates/tsconfig.spec.json"
    },
    {
      "path": "./apps/clients/tsconfig.app.json"
    },
    {
      "path": "./apps/clients/tsconfig.spec.json"
    }
  ]
}
