{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badge/**",
              "components/button/**",
              "components/card/**",
              "components/chips/**",
              "components/expansion/**",
              "components/form-field/**",
              "components/icon/**",
              "components/list/**",
              "components/menu/**",
              "components/overlay/**",
              "components/progress/**",
              "components/selection/**",
              "components/sidenav/**",
              "components/slider/**",
              "components/stepper/**",
              "components/table/**",
              "components/tabs/**",
              "components/toolbar/**",
              "ui_kits/back-office/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='Autocomplete'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|defaultValue|placeholder|hint|error|required|disabled|appearance|prefixIcon|open|block|width|onChange|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Autocomplete> doesn't accept that prop. Declared props: label, options, value, defaultValue, placeholder, hint, error, required, disabled, appearance, prefixIcon, open, block, width, onChange, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Autocomplete'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:outline|fill)$/]",
        "message": "<Autocomplete> appearance must be one of 'outline' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|size|position|overlap|hidden|inline|description|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: content, size, position, overlap, hidden, inline, description, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Badge> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:above after|above before|below after|below before)$/]",
        "message": "<Badge> position must be one of 'above after' | 'above before' | 'below after' | 'below before'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|inline|local|onClose|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, children, inline, local, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|trailingIcon|color|disabled|state|type|onClick|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, trailingIcon, color, disabled, state, type, onClick, children, className, style."
      },
