# Dev (ARCHITECTURE §5 "staging"): scales to zero, cheapest database, can be destroyed. Copy to dev.tfvars.
project_id         = "CHANGE_ME"
region             = "us-central1"
api_min_instances      = 0
db_tier                = "db-f1-micro"
db_deletion_protection = false
image_tag          = "2026-10-17"
admin_app_url      = "https://admin.example.com"
candidates_app_url = "https://candidatos.example.com"
clients_app_url    = "https://clientes.example.com"
email_from         = "Plataforma <no-reply@example.com>"
hosting_site_ids = {
  admin      = "CHANGE_ME-admin"
  candidatos = "CHANGE_ME-candidatos"
  clientes   = "CHANGE_ME-clientes"
}
# db_postgres_password: pass with TF_VAR_db_postgres_password instead of writing it here.
