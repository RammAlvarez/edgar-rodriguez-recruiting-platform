# Same-VM deployment (deploy/docker-compose.same-vm.yml). Copy to deploy/.env, fill every CHANGE_ME, never commit it.
# The API's variables are documented in the repository's .env.example; DATABASE_URL is set by the compose file.

# --- Sites (Caddy gets the HTTPS certificates; the DNS A records of the four names point to this VM) ---
ADMIN_SITE=admin.example.com
CANDIDATES_SITE=candidatos.example.com
CLIENTS_SITE=clientes.example.com
API_SITE=api.example.com
ACME_EMAIL=CHANGE_ME@example.com

# --- Database passwords (long random strings: openssl rand -base64 24) ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
PLATFORM_OWNER_PASSWORD=CHANGE_ME
PLATFORM_API_PASSWORD=CHANGE_ME
PLATFORM_READONLY_PASSWORD=CHANGE_ME

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
INTERNAL_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
APP_ORIGINS=https://admin.example.com,https://candidatos.example.com,https://clientes.example.com
ADMIN_APP_URL=https://admin.example.com
CANDIDATES_APP_URL=https://candidatos.example.com
CLIENTS_APP_URL=https://clientes.example.com
FIREBASE_PROJECT_ID=CHANGE_ME
# One line: the service account key JSON of the Firebase project (Project settings → Service accounts).
FIREBASE_SERVICE_ACCOUNT_JSON=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Plataforma <no-reply@example.com>
# openssl rand -base64 32 — back it up apart from the database (docs/HANDOFF.md «Llave de cifrado»).
ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_KEY_ID=1

# Request limits (PLAN D92), per minute unless the name says otherwise; 0 turns one off. Defaults shown.
# RATE_LIMIT_IP_PER_MINUTE=600            per client address, before the token is checked (an office shares one address)
# RATE_LIMIT_PORTAL_PER_MINUTE=120        per candidate or client user
# RATE_LIMIT_STAFF_PER_MINUTE=600         per staff user
# RATE_LIMIT_UPLOADS_PER_HOUR=30          upload links, candidates only
# RATE_LIMIT_BANK_ACCOUNTS_PER_HOUR=10    «Cuenta para tu pago»
# RATE_LIMIT_PROFILE_PER_10_MINUTES=30    «Mis datos»
# RATE_LIMIT_COMMENTS_PER_HOUR=30         a client's comments
# Proxies in front of the API that append X-Forwarded-For: 1 for Caddy, Cloud Run or App Platform; 2 with a load balancer
# in front of Cloud Run; 0 when nothing is in front. A wrong value lets a forged header pick its own address.
# TRUSTED_PROXY_HOPS=1

# --- S3-compatible bucket of a provider (Spaces, GCS interoperability, R2, S3) ---
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_DOCUMENTS=CHANGE_ME-documents
S3_BUCKET_EXPORTS=CHANGE_ME-exports
S3_FORCE_PATH_STYLE=false

# --- Optional ---
# PLATFORM_VERSION=2026-10-17   (image tag)
# HTTP_PORT=80
# HTTPS_PORT=443
