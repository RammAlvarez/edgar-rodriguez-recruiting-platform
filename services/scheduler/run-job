#!/bin/sh
# Calls one internal job; jobs are idempotent, so a retry after a failure is always safe.
set -eu
name="$1"
echo "$(date -u +%FT%TZ) job=$name start"
if curl -fsS --retry 3 --retry-delay 10 --max-time 300 -X POST \
    -H "X-Internal-Secret: ${INTERNAL_SECRET}" "${API_URL%/}/internal/jobs/${name}"; then
  echo
  echo "$(date -u +%FT%TZ) job=$name ok"
else
  echo "$(date -u +%FT%TZ) job=$name failed" >&2
fi
