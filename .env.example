# Environment variables of platform-api (ARCHITECTURE §6 "Secrets"). Production sets them on the container;
# locally `scripts/lib/env.mjs` fills the same names with defaults, and a repo-root .env (gitignored) overrides them.

# PostgreSQL over TCP — postgres://user:pass@host:port/db?sslmode=require or an Npgsql connection string.
DATABASE_URL=postgres://platform_api:CHANGE_ME@db.example.internal:5432/platform?sslmode=require
# Owner role, used only to run migrations (dotnet ef database update / the migration bundle).
MIGRATIONS_DATABASE_URL=postgres://platform_owner:CHANGE_ME@db.example.internal:5432/platform?sslmode=require

# Shared secret of the scheduler and service-to-service calls (≥ 32 characters).
INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Comma-separated origins of the three static apps (CORS).
APP_ORIGINS=https://admin.example.com,https://candidatos.example.com,https://clientes.example.com

# Identity provider (Firebase Auth). The service-account JSON is needed to create users and links.
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# S3-compatible storage (MinIO locally; GCS interoperability, Spaces or S3 in production).
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_DOCUMENTS=platform-documents
S3_BUCKET_EXPORTS=platform-exports
S3_FORCE_PATH_STYLE=true

# Email through Resend (plain HTTP). Locally an empty key writes the emails, links included, to the API log.
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=Plataforma de Reclutamiento <no-reply@example.com>

# Public URLs of the apps, used in email links.
ADMIN_APP_URL=https://admin.example.com
CANDIDATES_APP_URL=https://candidatos.example.com
CLIENTS_APP_URL=https://clientes.example.com

# AES-256-GCM key for account and card numbers: base64 of 32 random bytes (`openssl rand -base64 32`). Keep it out of the
# repository and back it up with the database: without it no account number can be read. ENCRYPTION_KEY_ID (1-255,
# default 1) is written in front of every value. During a key rotation ENCRYPTION_PREVIOUS_KEYS (id:base64,id:base64)
# keeps the old keys readable until the reencrypt-fields job has moved every value (docs/HANDOFF.md §6).
ENCRYPTION_KEY=CHANGE_ME_BASE64_OF_32_RANDOM_BYTES
ENCRYPTION_KEY_ID=1
ENCRYPTION_PREVIOUS_KEYS=

# Request limits (PLAN D92), per minute unless the name says otherwise; 0 turns one off. Defaults shown.
# RATE_LIMIT_IP_PER_MINUTE=600            per client address, before the token is checked (an office shares one address)
# RATE_LIMIT_PORTAL_PER_MINUTE=120        per candidate or client user
# RATE_LIMIT_STAFF_PER_MINUTE=600         per staff user
# RATE_LIMIT_UPLOADS_PER_HOUR=30          upload links, candidates only
# RATE_LIMIT_BANK_ACCOUNTS_PER_HOUR=10    «Cuenta para tu pago»
# RATE_LIMIT_PROFILE_PER_10_MINUTES=30    «Mis datos»
# RATE_LIMIT_COMMENTS_PER_HOUR=30         a client's comments
# Proxies in front of the API that append X-Forwarded-For: 1 for Caddy, Cloud Run or App Platform; 2 with a load balancer
# in front of Cloud Run; 0 when nothing is in front. A wrong value lets a forged header pick its own address.
# TRUSTED_PROXY_HOPS=1

# Local only (docker compose host ports, when the documented ones are taken).
# PLATFORM_DB_PORT=5433
# PLATFORM_S3_PORT=9000
# PLATFORM_S3_CONSOLE_PORT=9001
